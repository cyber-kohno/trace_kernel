  "description": "",
  "type": "module",
  "scripts": {
    "check:release": "node ../../release/check-desktop-mcp.mjs && node ../../release/test-desktop-mcp.mjs",
    "precheck": "npm run check:release",
    "precheck:watch": "node ../../release/check-desktop-mcp.mjs",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "format": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "check:mcp-api-coverage": "node scripts/check-mcp-api-coverage.mjs",
    "check:mcp-api-behavior": "node scripts/test-mcp-api-behavior.mjs",
    "test:transaction": "node scripts/test-transaction.mjs",
    "test:runtime-lifecycle": "node scripts/test-runtime-lifecycle.mjs",
    "test:workspace-load": "node scripts/test-workspace-load.mjs",
    "test:work-execution-plan": "node scripts/test-work-execution-plan.mjs",
    "test:io-context": "node scripts/test-io-context.mjs",
    "test:execute-work": "node scripts/test-execute-work.mjs",
    "test:mcp-diagnostics": "node scripts/test-mcp-diagnostics.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && node ./scripts/check-mcp-api-coverage.mjs && node ./scripts/test-mcp-api-behavior.mjs && node ./scripts/test-mcp-context-consistency.mjs && npm run test:transaction && npm run test:runtime-lifecycle && npm run test:workspace-load && npm run test:work-execution-plan && npm run test:io-context && npm run test:execute-work && npm run test:mcp-diagnostics && npm run test:runtime-core",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "workspace:fixture": "node ./scripts/export-workspace-fixture.mjs",
    "tauri": "tauri",
    "test:runtime-core": "npm --prefix ../../packages/runtime-core run check",
    "test:shared-runtime-dev": "node scripts/test-shared-runtime-dev.mjs"
  },
